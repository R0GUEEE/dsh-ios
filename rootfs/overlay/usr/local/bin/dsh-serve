#!/bin/sh
# Launch the DeepSeek Harness web UI inside the DSH iOS app's Linux guest.
#
# The iOS app runs this as the supervised foreground process and points its
# WKWebView at http://127.0.0.1:$DSH_PORT once the server answers.
#
#   DSH_PORT       listen port (default 3080)
#   DSH_WORKSPACE  initial working directory offered as the workspace
#   DSH_HOME       harness home (default /root/.dsh)
export HOME=/root
export DSH_HOME="${DSH_HOME:-/root/.dsh}"
export DSH_WORKSPACE="${DSH_WORKSPACE:-/root/workspace}"
PORT="${DSH_PORT:-3080}"

mkdir -p "$DSH_WORKSPACE"

# Keep the patches this image ships in place. A harness home migrated from an
# older image (see DSHRootUpgrader) carries that image's copies, which would
# silently pin old settings — and would drop plugins this image adds, such as
# the host bridge.
mkdir -p "$DSH_HOME"
install -m 0644 /usr/local/share/dsh/home.patch.yml "$DSH_HOME/cordis.patch.yml"
[ -d "$DSH_HOME/profiles/web" ] && install -m 0644 /usr/local/share/dsh/cordis.patch.yml "$DSH_HOME/profiles/web/cordis.patch.yml"

cd "$DSH_WORKSPACE"

# Plugin platform. `dsh plugin add <name>` runs pnpm inside the profile
# directory, so the pinned tree at /usr/local/lib/node_modules is invisible to
# it and every name looks like an unknown package. Expose the tree on NODE_PATH
# instead of copying it into the profile: the profile directory belongs to the
# agent, and a second copy there would both double the image's install time and
# give the agent a writable copy of the very packages it is told to mount.
# Precedence is still the agent's: Node resolves ./node_modules before
# NODE_PATH, so a plugin the profile really fetched wins over this tree.
DSH_NODE_MODULES=/usr/local/lib/node_modules
export NODE_PATH="$DSH_NODE_MODULES${NODE_PATH:+:$NODE_PATH}"

# Settings the app writes (never the agent — see DSHActivityLog and
# docs/host-bridge.md) reach the in-guest policy through these paths.
export DSH_IMAGE_MANIFEST=/usr/local/share/dsh/image.json
export DSH_IOS_SETTINGS="${DSH_IOS_SETTINGS:-$DSH_HOME/ios.json}"
# MCP servers the user configured. Seeded once from the image's example on
# first launch, then owned by the user: an update never overwrites it.
export DSH_MCP_CONFIG="${DSH_MCP_CONFIG:-$DSH_HOME/mcp.json}"
if [ ! -f "$DSH_MCP_CONFIG" ] && [ -f /usr/local/share/dsh/mcp.example.json ]; then
    install -m 0644 /usr/local/share/dsh/mcp.example.json "$DSH_MCP_CONFIG"
fi

# --expose-internals: cordis-plugin-hmr needs Node internals; the prebuilt
# node-addon-require-builtin shim has no musl build, so use the flag instead.
exec node --expose-internals \
    /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js \
    web --host 127.0.0.1 --port "$PORT" "$@"
